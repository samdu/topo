#!/usr/bin/python3
# A stand-in for `claude -p --input-format stream-json --output-format stream-json --verbose
# --replay-user-messages`, speaking the lines Claude Code 2.1.325 writes (captured signed out, and
# trimmed). What it was started with and every input it took are written under FAKE_LOG.
#
# FAKE_SIGNED_OUT=1  every turn fails as Claude Code's does with no login
# FAKE_LOGIN_SIGNED_OUT=1  `auth status` says signed out
# FAKE_STRAY=1       a turn of its own (a background task's notice) ends before each input's echo
# FAKE_CHILD=1       starts two children at launch: one in its group, one in a session of its own
# FAKE_IGNORE_TERM=1 ignores SIGTERM, and stays after its stdin closes
# FAKE_DIE=1         exits at launch, saying FAKE_DIE_SAYS (or "it died") on stderr
# An input containing FAIL ends with an error result; one containing SLOW waits 1.5 s to answer;
# one containing HANG writes nothing more after its echo, ever; one containing CHATTY writes a
# tool_progress heartbeat (2.1.325's line, every 30 s while a tool runs) every 0.25 s for 3 s and
# then answers; one containing BUSY writes that heartbeat every 0.25 s and never answers. One
# containing STREAM writes its reply as two messages a piece at a time, 0.2 s apart, a tool call
# between them and a sub-agent's words inside it, and before its result waits (10 s at most) for a
# file named `release` under FAKE_LOG; its reply is "One. Two.\n\nThree.".
import json, os, signal, subprocess, sys, time, uuid

log = os.environ["FAKE_LOG"]
config = os.environ.get("CLAUDE_CONFIG_DIR", "")
os.makedirs(log, exist_ok=True)

def record(name, obj):
    with open(os.path.join(log, name), "a") as f:
        f.write(json.dumps(obj) + "\n")

def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()

args = sys.argv[1:]
if args[:2] == ["auth", "status"]:
    # `claude auth status --json`, as 2.1.325 prints it; FAKE_LOGIN_SIGNED_OUT=1 is signed out.
    record("auth.jsonl", {"args": args, "config": config})
    signed_in = os.environ.get("FAKE_LOGIN_SIGNED_OUT") != "1"
    print(json.dumps({"loggedIn": signed_in, "authMethod": "claude.ai" if signed_in else "none",
                      "apiProvider": "firstParty", "subscriptionType": "max" if signed_in else None,
                      "configDirectory": config}, indent=2))
    sys.exit(0 if signed_in else 1)
record("launches.jsonl", {"pid": os.getpid(), "args": args, "cwd": os.getcwd(), "env": dict(os.environ)})
if os.environ.get("FAKE_DIE") == "1":
    sys.stderr.write(os.environ.get("FAKE_DIE_SAYS", "it died") + "\n")
    sys.exit(1)
if os.environ.get("FAKE_IGNORE_TERM") == "1":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

def flag(name):
    return args[args.index(name) + 1] if name in args else None

sessions = os.path.join(config or log, "fake-sessions")
os.makedirs(sessions, exist_ok=True)
resume = flag("--resume")
model = flag("--model") or "claude-sonnet"
if resume is not None:
    if not os.path.exists(os.path.join(sessions, resume)):
        message = "No conversation found with session ID: " + resume
        sys.stderr.write(message + "\n")
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "num_turns": 0,
              "session_id": resume, "errors": [message]})
        sys.exit(1)
    session = resume
else:
    session = str(uuid.uuid4())
open(os.path.join(sessions, session), "a").close()

if os.environ.get("FAKE_CHILD") == "1":
    near = subprocess.Popen(["/bin/sleep", "1000"])
    far = subprocess.Popen(["/bin/sleep", "1001"], start_new_session=True)
    record("children.jsonl", {"pids": [near.pid, far.pid]})

def turn(line):
    content = line["message"]["content"]
    input_id = line.get("uuid")
    record("inputs.jsonl", {"session": session, "content": content, "uuid": input_id, "pid": os.getpid()})
    if os.environ.get("FAKE_STRAY") == "1":
        emit({"type": "system", "subtype": "init", "session_id": session, "model": model})
        emit({"type": "assistant", "message": {"id": "stray", "model": model, "role": "assistant",
              "content": [{"type": "text", "text": "a background notice, not the reply"}]},
              "session_id": session, "parent_tool_use_id": None})
        emit({"type": "result", "subtype": "success", "is_error": False, "result": "stray",
              "session_id": session})
    emit({"type": "command_lifecycle", "command_uuid": input_id, "state": "started", "session_id": session})
    emit({"type": "system", "subtype": "init", "session_id": session, "model": model, "cwd": os.getcwd()})
    emit({"type": "user", "message": {"role": "user", "content": content}, "session_id": session,
          "parent_tool_use_id": None, "uuid": input_id, "isReplay": True})
    if os.environ.get("FAKE_SIGNED_OUT") == "1":
        emit({"type": "assistant", "message": {"id": str(uuid.uuid4()), "model": "<synthetic>", "role": "assistant",
              "content": [{"type": "text", "text": "Not logged in · Please run /login"}]},
              "session_id": session, "parent_tool_use_id": None, "error": "authentication_failed"})
        emit({"type": "result", "subtype": "success", "is_error": True, "result": "Not logged in · Please run /login",
              "session_id": session, "user_message_uuid": input_id, "terminal_reason": "api_error"})
        return
    if "SLOW" in content:
        time.sleep(1.5)
    if "HANG" in content:
        while True:
            time.sleep(60)
    if "CHATTY" in content or "BUSY" in content:
        tool = "toolu_" + uuid.uuid4().hex[:24]
        beat = 0
        while "BUSY" in content or beat < 12:
            time.sleep(0.25)
            emit({"type": "tool_progress", "tool_use_id": tool + "-heartbeat-" + str(beat), "tool_name": "Bash",
                  "parent_tool_use_id": tool, "elapsed_time_seconds": 30 * (beat + 1), "heartbeat": True,
                  "session_id": session})
            beat += 1
    if "FAIL" in content:
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "session_id": session,
              "user_message_uuid": input_id, "errors": ["boom"]})
        return
    if "STREAM" in content:
        def event(e, parent=None):
            emit({"type": "stream_event", "event": e, "session_id": session, "parent_tool_use_id": parent})
        first, second, tool = str(uuid.uuid4()), str(uuid.uuid4()), "toolu_" + uuid.uuid4().hex[:24]
        event({"type": "message_start", "message": {"model": model, "id": first, "type": "message", "role": "assistant", "content": []}})
        event({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        for piece in ["One. ", "Two."]:
            time.sleep(0.2)
            event({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": piece}})
        event({"type": "content_block_stop", "index": 0})
        event({"type": "content_block_start", "index": 1, "content_block": {"type": "tool_use", "id": tool, "name": "Bash", "input": {}}})
        event({"type": "content_block_delta", "index": 1, "delta": {"type": "input_json_delta", "partial_json": "{\"command\": \"ls SECRET\"}"}})
        emit({"type": "assistant", "message": {"id": first, "model": model, "role": "assistant",
              "content": [{"type": "text", "text": "One. Two."}, {"type": "tool_use", "id": tool, "name": "Bash", "input": {"command": "ls SECRET"}}]},
              "session_id": session, "parent_tool_use_id": None})
        event({"type": "message_start", "message": {"model": model, "id": "sub", "type": "message", "role": "assistant", "content": []}}, tool)
        event({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "SUBAGENT"}}, tool)
        time.sleep(0.2)
        event({"type": "message_start", "message": {"model": model, "id": second, "type": "message", "role": "assistant", "content": []}})
        event({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        event({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "Three."}})
        emit({"type": "assistant", "message": {"id": second, "model": model, "role": "assistant",
              "content": [{"type": "text", "text": "Three."}]}, "session_id": session, "parent_tool_use_id": None})
        release = os.path.join(log, "release")
        for _ in range(200):
            if os.path.exists(release):
                break
            time.sleep(0.05)
        emit({"type": "result", "subtype": "success", "is_error": False, "result": "Three.",
              "session_id": session, "user_message_uuid": input_id})
        return
    words = content.split("\n\n")[-1]
    message = str(uuid.uuid4())
    if "--include-partial-messages" in args:
        # The pieces 2.1.325 writes as the model makes the reply (trimmed), before the whole message.
        emit({"type": "system", "subtype": "status", "status": "requesting", "session_id": session})
        emit({"type": "stream_event", "event": {"type": "message_start", "message": {"model": model, "id": message,
              "type": "message", "role": "assistant", "content": []}}, "session_id": session, "parent_tool_use_id": None})
        emit({"type": "stream_event", "event": {"type": "content_block_start", "index": 0,
              "content_block": {"type": "text", "text": ""}}, "session_id": session, "parent_tool_use_id": None})
        for piece in ["echo: ", words]:
            emit({"type": "stream_event", "event": {"type": "content_block_delta", "index": 0,
                  "delta": {"type": "text_delta", "text": piece}}, "session_id": session, "parent_tool_use_id": None})
        emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}, "session_id": session,
              "parent_tool_use_id": None})
        emit({"type": "stream_event", "event": {"type": "message_stop"}, "session_id": session, "parent_tool_use_id": None})
    emit({"type": "assistant", "message": {"id": message, "model": model, "role": "assistant",
          "content": [{"type": "thinking", "thinking": ""}, {"type": "text", "text": "echo: " + words}],
          "usage": {"input_tokens": 10, "cache_creation_input_tokens": 5, "cache_read_input_tokens": 100,
                    "output_tokens": 7}},
          "session_id": session, "parent_tool_use_id": None})
    emit({"type": "result", "subtype": "success", "is_error": False, "result": "echo: " + words,
          "session_id": session, "user_message_uuid": input_id})

for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    line = json.loads(raw)
    if line.get("type") == "control_request":
        emit({"type": "control_response", "response": {"subtype": "success", "request_id": line["request_id"],
              "response": {"commands": []}}})
    elif line.get("type") == "user":
        turn(line)

if os.environ.get("FAKE_IGNORE_TERM") == "1":
    while True:
        time.sleep(60)
