+// Frees a dirent, its inode and everything under it, outright rather than by releasing: by the
+// time mount_remove calls umount the mount's refcount is 0, so no fd holds a dirent of this tree
+// (every open fd holds a reference on its mount), and this filesystem has no unlink, rmdir, rename
+// or link, so the dirents are a tree with no pointer into it from outside. What the refcounts say
+// is beside the point here: tmpfs_dir_link retains an inode it was handed ownership of, and the
+// root's `dir` link is never initialised, so a release walk would leak the inodes and remove the
+// root from no list.
+static void tmpfs_free_tree(struct tmp_dirent *dirent) {
+    struct tmp_dirent *child, *tmp;
+    list_for_each_entry_safe(&dirent->children, child, tmp, dir) {
+        tmpfs_free_tree(child);
     }
-    tmp_inode_release(tree);
+    if (dirent->inode != NULL)
+        tmp_inode_cleanup(dirent->inode);
+    free(dirent);
 }
