+#ifdef GUEST_ARM64
+// The page whose W^X mark this thread's last gadget write miss took off, its
+// store handed to tlb_store_buffered rather than made through the pointer.
+static __thread page_t code_store_page = TLB_PAGE_EMPTY;
+
+// A gadget's write miss (handle_write_miss). When the miss took the W^X mark
+// off a page of translated code, the store is not let through the pointer the
+// miss found: a compile between the clearing and the store would read the old
+// bytes and keep a block of them. The gadget is handed the cpu's store buffer
+// instead, as for a store across pages, so write_done hands it to
+// tlb_store_buffered, which makes the store in C and then clears again.
+__no_instrument void *tlb_handle_write_miss(struct tlb *tlb, addr_t addr, char *buffer, addr_t *buffer_addr) {
+    mmu_code_cleared_reset();
+    void *ptr = tlb_handle_miss(tlb, addr, MEM_WRITE);
+    if (ptr != NULL && mmu_code_cleared_take()) {
+        code_store_page = PAGE(addr);
+        *buffer_addr = addr;
+        return buffer;
+    }
+    return ptr;
+}
+
+// One page's part of a buffered store, and the W^X tail after it when this
+// store's miss, or the gadget's miss that redirected it, cleared the mark.
+static bool store_part(struct tlb *tlb, addr_t addr, const char *value, unsigned size) {
+    mmu_code_cleared_reset();
+    char *ptr = __tlb_write_ptr(tlb, addr);
+    bool cleared = mmu_code_cleared_take() || PAGE(addr) == code_store_page;
+    if (ptr == NULL)
+        return false;
+    memcpy(ptr, value, size);
+    if (cleared)
+        mmu_code_store_landed(tlb->mmu, PAGE(addr));
+    return true;
+}
+
+// The store write_done hands over from the cpu's store buffer: one across
+// pages, or one whose write miss took a page's W^X mark off.
+__no_instrument bool tlb_store_buffered(struct tlb *tlb, addr_t addr, const char *value, unsigned size) {
+    unsigned part1 = PGOFFSET(addr) > PAGE_SIZE - size ? PAGE_SIZE - PGOFFSET(addr) : size;
+    bool stored = store_part(tlb, addr, value, part1) &&
+        (part1 == size || store_part(tlb, (PAGE(addr) + 1) << PAGE_BITS, value + part1, size - part1));
+    code_store_page = TLB_PAGE_EMPTY;
+    return stored;
+}
