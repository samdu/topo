+
+bool mmu_code_cleared_take(void) {
+    bool cleared = code_cleared;
+    code_cleared = false;
+    return cleared;
+}
+
+void mmu_code_store_landed(struct mmu *mmu, page_t page) {
+    struct mem *mem = container_of(mmu, struct mem, mmu);
+    // The store first, then the clear and the bump: a compile that read its
+    // generation before this sees it move and compiles again, from the new bytes.
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    struct pt_entry *entry = mem_pt(mem, page);
+    if (entry != NULL)
