-// preadv/pwritev — ARM64 Linux ABI splits the loff_t offset into pos_l/pos_h
-// registers (5-argument syscall form), consistent with what musl's
-// src/unistd/pwritev.c emits. Combine them back into a 64-bit offset before
-// doing the pread/pwrite loop under fd->lock (like readv/writev).
+// The offset of preadv, pwritev and their v2 forms, which the syscall splits
+// across two registers. A 64-bit kernel takes it whole from the low one and
+// ignores the high one (Linux's pos_from_hilo): musl passes the offset's top
+// half there, Zig's std, which Bun calls through, passes 0, so -1 (the current
+// position) is read from pos_l alone or a stream write becomes a positional one
+// at 4 GiB, which a pipe refuses.
+static off_t_ pos_from_hilo(addr_t pos_l, dword_t pos_h) {
+#if defined(GUEST_ARM64)
+    (void) pos_h;
+    return (off_t_) pos_l;
+#else
+    return ((qword_t) pos_h << 32) | (dword_t) pos_l;
+#endif
+}
