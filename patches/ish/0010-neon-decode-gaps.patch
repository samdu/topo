+/*
+ * SQSHLU / UQSHL (vector, immediate) - saturating shift left by an immediate
+ * Code stream: [gadget addr][rd | rn<<8 | shift<<16 | esize<<24 | Q<<28]
+ *
+ * Run on the host's NEON as UQSHL by register, the shift in every element.
+ * SQSHLU reads its elements as signed and saturates to the unsigned range, so
+ * its negative elements are zeroed first and the rest is UQSHL.
+ */
+.macro make_sat_shl_imm name, from_signed
+.gadget \name\()_imm_vec
+    ldr x8, [_pc]
+    add _pc, _pc, #8
+
+    and x9, x8, #0x1f       // rd
+    ubfx x10, x8, #8, #5    // rn
+    ubfx x11, x8, #16, #8   // shift amount
+    ubfx x12, x8, #24, #4   // esize (0=8, 1=16, 2=32, 3=64)
+    ubfx x17, x8, #28, #1   // Q
+
+    add x13, _cpu, #CPU_fp
+    lsl x14, x9, #4
+    add x14, x13, x14       // &Vd
+    lsl x15, x10, #4
+    add x15, x13, x15       // &Vn
+
+    ldr q0, [x15]
+
+    cmp x12, #1
+    b.lo .L\name\()_imm_b
+    b.eq .L\name\()_imm_h
+    cmp x12, #2
+    b.eq .L\name\()_imm_s
+
+    dup v1.2d, x11
+.if \from_signed
+    cmge v2.2d, v0.2d, #0
+    and v0.16b, v0.16b, v2.16b
+.endif
+    uqshl v0.2d, v0.2d, v1.2d
+    b .L\name\()_imm_store
+
+.L\name\()_imm_b:
+    dup v1.16b, w11
+.if \from_signed
+    cmge v2.16b, v0.16b, #0
+    and v0.16b, v0.16b, v2.16b
+.endif
+    uqshl v0.16b, v0.16b, v1.16b
+    b .L\name\()_imm_store
+
+.L\name\()_imm_h:
+    dup v1.8h, w11
+.if \from_signed
+    cmge v2.8h, v0.8h, #0
+    and v0.16b, v0.16b, v2.16b
+.endif
+    uqshl v0.8h, v0.8h, v1.8h
+    b .L\name\()_imm_store
+
+.L\name\()_imm_s:
+    dup v1.4s, w11
+.if \from_signed
+    cmge v2.4s, v0.4s, #0
+    and v0.16b, v0.16b, v2.16b
+.endif
+    uqshl v0.4s, v0.4s, v1.4s
+
+.L\name\()_imm_store:
+    cbz x17, .L\name\()_imm_store_low
+    str q0, [x14]
+    gret
+.L\name\()_imm_store_low:
+    str d0, [x14]
+    str xzr, [x14, #8]
+    gret
+.endm
+
+make_sat_shl_imm sqshlu, 1
+make_sat_shl_imm uqshl, 0
+
+/*
+ * SCVTF / UCVTF (vector, fixed-point) - integer to FP with fractional bits
+ * Code stream: [gadget addr][rd | rn<<8 | fbits<<16 | esize<<24 | Q<<28]
+ *
+ * esize: 2 = single, 3 = double. The integer conversion on the host's NEON,
+ * which rounds once, then a multiplication by 2^-fbits, which is exact: the
+ * smallest result is 2^-64, far from subnormal.
+ */
+.macro make_cvtf_fixpt_vec name
+.gadget \name\()_fixpt_vec
+    ldr x8, [_pc]
+    add _pc, _pc, #8
+
+    and x9, x8, #0x1f       // rd
+    ubfx x10, x8, #8, #5    // rn
+    ubfx x11, x8, #16, #8   // fbits
+    ubfx x12, x8, #24, #4   // esize (2=32, 3=64)
+    ubfx x17, x8, #28, #1   // Q
+
+    add x13, _cpu, #CPU_fp
+    lsl x14, x9, #4
+    add x14, x13, x14       // &Vd
+    lsl x15, x10, #4
+    add x15, x13, x15       // &Vn
+
+    ldr q0, [x15]
+
+    cmp x12, #3
+    b.eq .L\name\()_fixpt_d
+
+    cbnz x17, .L\name\()_fixpt_s
+    mov v0.8b, v0.8b        // 2S: the upper half is not converted
+.L\name\()_fixpt_s:
+    \name v0.4s, v0.4s
+    mov w16, #127
+    sub w16, w16, w11
+    lsl w16, w16, #23       // 2^-fbits as a single
+    dup v1.4s, w16
+    fmul v0.4s, v0.4s, v1.4s
+    str q0, [x14]
+    gret
+
+.L\name\()_fixpt_d:
+    \name v0.2d, v0.2d
+    mov x16, #1023
+    sub x16, x16, x11
+    lsl x16, x16, #52       // 2^-fbits as a double
+    dup v1.2d, x16
+    fmul v0.2d, v0.2d, v1.2d
+    str q0, [x14]
+    gret
+.endm
+
+make_cvtf_fixpt_vec scvtf
+make_cvtf_fixpt_vec ucvtf
+
+/*
+ * UDOT (vector) - unsigned dot product, accumulated into 32-bit elements
+ * Code stream: [gadget addr][rd | rn<<8 | rm<<16 | Q<<24]
+ *
+ * Each 32-bit element of Vd gains the sum of the four byte products under it.
+ * From widening multiplies and pairwise adds, not the host's UDOT, which is
+ * outside the build's iOS 17 baseline.
+ */
+.gadget udot_vec
+    ldr x8, [_pc]
+    add _pc, _pc, #8
+
+    and x9, x8, #0x1f       // rd
+    ubfx x10, x8, #8, #5    // rn
+    ubfx x11, x8, #16, #5   // rm
+    ubfx x17, x8, #24, #1   // Q
+
+    add x13, _cpu, #CPU_fp
+    lsl x14, x9, #4
+    add x14, x13, x14       // &Vd
+    lsl x15, x10, #4
+    add x15, x13, x15       // &Vn
+    lsl x16, x11, #4
+    add x16, x13, x16       // &Vm
+
+    ldr q0, [x15]
+    ldr q1, [x16]
+    ldr q2, [x14]
+
+    umull v3.8h, v0.8b, v1.8b       // the low eight products
+    umull2 v0.8h, v0.16b, v1.16b    // the high eight
+    uaddlp v3.4s, v3.8h             // in pairs
+    uaddlp v0.4s, v0.8h
+    addp v3.4s, v3.4s, v0.4s        // in fours, low elements then high
+    add v2.4s, v2.4s, v3.4s
+
+    cbz x17, .Ludot_vec_low
+    str q2, [x14]
+    gret
+.Ludot_vec_low:
+    str d2, [x14]
+    str xzr, [x14, #8]
+    gret
+
+/*
+ * FNEG (vector, half-precision) - flip each 16-bit element's sign bit
+ * Code stream: [gadget addr][rd | rn<<8 | Q<<16]
+ */
+.gadget fneg_half_vec
+    ldr x8, [_pc]
+    add _pc, _pc, #8
+
+    and x9, x8, #0x1f       // rd
+    ubfx x10, x8, #8, #5    // rn
+    ubfx x17, x8, #16, #1   // Q
+
+    add x13, _cpu, #CPU_fp
+    lsl x14, x9, #4
+    add x14, x13, x14       // &Vd
+    lsl x15, x10, #4
+    add x15, x13, x15       // &Vn
+
+    ldr q0, [x15]
+    movi v1.8h, #0x80, lsl #8
+    eor v0.16b, v0.16b, v1.16b
+
+    cbz x17, .Lfneg_half_vec_low
+    str q0, [x14]
+    gret
+.Lfneg_half_vec_low:
+    str d0, [x14]
+    str xzr, [x14, #8]
+    gret
+
 /*
  * SHL (vector, immediate) - shift left immediate
