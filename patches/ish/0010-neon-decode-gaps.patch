@@ -4163,6 +4169,100 @@ static int gen_simd_fp(struct gen_state *state, uint32_t insn) {
         return 1;
     }
 
+    // SQSHLU / UQSHL (vector, immediate) - saturating shift left by an immediate
+    // SQSHLU: 0 Q 1 011110 immh immb 011001 Rn Rd
+    // UQSHL:  0 Q 1 011110 immh immb 011101 Rn Rd
+    // immh:immb is the element size plus the shift, as for SHL; immh=0 is
+    // MVNI/BIC, and 1D (immh=1xxx, Q=0) is unallocated. Autovectorised pixel
+    // packing reaches SQSHLU, and zlib's Adler-32 UQSHL. FPSR.QC is not
+    // modelled, as for the other saturating gadgets.
+    if ((insn & 0xbf80ec00) == 0x2f006400) {
+        uint32_t immh = (insn >> 19) & 0xf;
+        if (immh != 0) {
+            uint32_t Q = (insn >> 30) & 1;
+            uint32_t immb = (insn >> 16) & 0x7;
+            uint32_t rd = insn & 0x1f;
+            uint32_t rn = (insn >> 5) & 0x1f;
+
+            if ((immh & 0x8) && Q == 0) {
+                gen_interrupt(state, INT_UNDEFINED);
+                return 0;
+            }
+
+            uint32_t esize = (immh & 0x8) ? 3 : (immh & 0x4) ? 2 : (immh & 0x2) ? 1 : 0;
+            uint32_t shift = ((immh << 3) | immb) - (8u << esize);
+
+            void *gadget = (insn & 0x1000) ? gadget_uqshl_imm_vec : gadget_sqshlu_imm_vec;
+            gen(state, (unsigned long) gadget);
+            // Pack: rd | rn<<8 | shift<<16 | esize<<24 | Q<<28
+            gen(state, rd | (rn << 8) | (shift << 16) | (esize << 24) | (Q << 28));
+            return 1;
+        }
+        // Fall through to the MVNI/BIC handler when immh=0
+    }
+
+    // SCVTF / UCVTF (vector, fixed-point) - integer to FP with fractional bits
+    // 0 Q U 011110 immh immb 111001 Rn Rd  (U=0 SCVTF, U=1 UCVTF)
+    // immh:immb is twice the element size less the fractional bits; immh=0 is
+    // MOVI. 8-bit elements (immh=0001) and 1D (immh=1xxx, Q=0) are
+    // unallocated, and 16-bit ones (immh=001x) are half-precision, which the
+    // guest does not report. Autovectorised integer-to-double scaling reaches
+    // both on .2D.
+    if ((insn & 0x9f80fc00) == 0x0f00e400) {
+        uint32_t immh = (insn >> 19) & 0xf;
+        if (immh != 0) {
+            uint32_t Q = (insn >> 30) & 1;
+            uint32_t U = (insn >> 29) & 1;
+            uint32_t immb = (insn >> 16) & 0x7;
+            uint32_t rd = insn & 0x1f;
+            uint32_t rn = (insn >> 5) & 0x1f;
+
+            if ((immh & 0xc) == 0 || ((immh & 0x8) && Q == 0)) {
+                gen_interrupt(state, INT_UNDEFINED);
+                return 0;
+            }
+
+            uint32_t esize = (immh & 0x8) ? 3 : 2;
+            uint32_t fbits = (16u << esize) - ((immh << 3) | immb);
+
+            void *gadget = U ? gadget_ucvtf_fixpt_vec : gadget_scvtf_fixpt_vec;
+            gen(state, (unsigned long) gadget);
+            // Pack: rd | rn<<8 | fbits<<16 | esize<<24 | Q<<28
+            gen(state, rd | (rn << 8) | (fbits << 16) | (esize << 24) | (Q << 28));
+            return 1;
+        }
