+    }
+
+    // UDOT (vector) - unsigned dot product
+    // 0 Q 1 01110 10 0 Rm 100101 Rn Rd; every other size is unallocated.
+    // The guest does not report the dot-product feature, so only code that
+    // does not ask reaches it.
+    if ((insn & 0xbfe0fc00) == 0x2e809400) {
+        uint32_t Q = (insn >> 30) & 1;
+        uint32_t rm = (insn >> 16) & 0x1f;
+        uint32_t rn = (insn >> 5) & 0x1f;
+        uint32_t rd = insn & 0x1f;
+
+        gen(state, (unsigned long) gadget_udot_vec);
+        gen(state, rd | (rn << 8) | (rm << 16) | (Q << 24));
+        return 1;
+    }
+
+    // FNEG (vector, half-precision)
+    // 0 Q 1 01110 1 111100 0 01111 10 Rn Rd
+    // A sign flip, so it needs no half-precision arithmetic: code compiled
+    // for half-precision builds 16-bit constants with it.
+    if ((insn & 0xbffffc00) == 0x2ef8f800) {
+        uint32_t Q = (insn >> 30) & 1;
+        uint32_t rn = (insn >> 5) & 0x1f;
+        uint32_t rd = insn & 0x1f;
+
+        gen(state, (unsigned long) gadget_fneg_half_vec);
+        gen(state, rd | (rn << 8) | (Q << 16));
+        return 1;
+    }
+
