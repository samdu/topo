+extern void gadget_sqshlu_imm_vec(void);   // SQSHLU Vd, Vn, #imm (signed saturating shift left unsigned, immediate)
+extern void gadget_uqshl_imm_vec(void);    // UQSHL Vd, Vn, #imm (unsigned saturating shift left, immediate)
+extern void gadget_scvtf_fixpt_vec(void);  // SCVTF Vd, Vn, #fbits (signed int to FP fixed-point, vector)
