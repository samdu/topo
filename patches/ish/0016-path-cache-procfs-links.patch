diff --git a/fs/path.c b/fs/path.c
index 1a057a0b..549df360 100644
--- a/fs/path.c
+++ b/fs/path.c
@@ -131,6 +131,14 @@ static void path_cache_set(const char *full_path, int flags, const char *normali
     unlock(&path_cache_lock);
 }
 
+// Set by a walk that looked a component up on procfs, link or not. What procfs
+// answers is the process's own (/proc/self, /proc/<pid>/fd/N, cwd, exe, and
+// /dev/fd through them) and changes with no namespace mutation: opening or
+// closing an fd invalidates nothing. So such a walk is not put in the cache
+// every process shares, a link that did not resolve included, since that
+// unresolved path would be handed to a process for which it now resolves.
+static __thread bool path_walk_per_process;
+
 static int __path_normalize(const char *at_path, const char *path, char *out, int flags, int levels) {
     // you must choose one
     if (flags & N_SYMLINK_FOLLOW)
@@ -223,6 +231,8 @@ static int __path_normalize(const char *at_path, const char *path, char *out, in
             struct mount *mount = find_mount_and_trim_path(possible_symlink);
             assert(path_is_normalized(possible_symlink));
             int res = _EINVAL;
+            if (mount->fs == &procfs)
+                path_walk_per_process = true;
             if (mount->fs->readlink)
                 res = mount->fs->readlink(mount, possible_symlink, c, MAX_PATH - (c - out));
             if (res >= 0) {
@@ -305,10 +315,12 @@ int path_normalize(struct fd *at, const char *path, char *out, int flags) {
     if (path_cache_get(full_input, flags, out, gen) == 0)
         return 0;
 
+    path_walk_per_process = false;
     int result = __path_normalize(at != NULL ? at_path : NULL, path, out, flags, 0);
 
-    // Only successful results are cached; an error must be re-derived.
-    if (result == 0)
+    // Only successful results are cached; an error must be re-derived, and a
+    // walk that looked anything up on procfs is the process's own.
+    if (result == 0 && !path_walk_per_process)
         path_cache_set(full_input, flags, out, gen);
 
     return result;
